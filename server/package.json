{
  "name": "zello-cloud-server",
  "version": "1.1.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node src/db/seed.js",
    "token:create": "node --env-file-if-exists=.env scripts/create-token.js",
    "restore-code:create": "node --env-file-if-exists=.env scripts/create-restore-code.js",
    "release:publish": "node --env-file-if-exists=.env scripts/publish-release.js",
    "test": "node --env-file-if-exists=.env --test test/cloud.test.js",
    "test:legacy": "node test/api.test.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.4",
    "fastify": "5.12.5"
  }
}
